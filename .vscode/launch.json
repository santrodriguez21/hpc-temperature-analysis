{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Ejecutar Secuencial",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/seq",
            "args": [
                "data/sample_data.csv",  // Número de líneas a procesar (opcional)
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "preLaunchTask": "Compilar Secuencial",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Ejecutar POSIX Threads",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/pth",
            "args": [
                "data/sample_data.csv",
                "2000000",  // Número de líneas a procesar
                "4"      // Número de hilos
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "preLaunchTask": "Compilar POSIX Threads",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Ejecutar OpenMPI",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/mpi",
            "args": [
                "data/sample_data.csv",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "preLaunchTask": "Compilar OpenMPI",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
